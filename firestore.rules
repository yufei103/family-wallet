rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function email() { return signedIn() ? request.auth.token.email : null; }
    function household(householdId) { return get(/databases/$(database)/documents/households/$(householdId)); }
    function householdAfter(householdId) { return getAfter(/databases/$(database)/documents/households/$(householdId)); }
    function member(householdId, uid) { return get(/databases/$(database)/documents/households/$(householdId)/members/$(uid)); }
    function access(uid) { return get(/databases/$(database)/documents/access/$(uid)); }
    function inviteForCurrentEmail() { return get(/databases/$(database)/documents/invites/$(email())); }
    function inviteAfterCurrentEmail() { return getAfter(/databases/$(database)/documents/invites/$(email())); }
    function itemPath(householdId, itemId) { return /databases/$(database)/documents/households/$(householdId)/items/$(itemId); }
    function paymentPath(householdId, paymentId) { return /databases/$(database)/documents/households/$(householdId)/itemPayments/$(paymentId); }
    function mediaPath(householdId, mediaId) { return /databases/$(database)/documents/households/$(householdId)/itemMedia/$(mediaId); }
    function transactionPath(householdId, transactionId) { return /databases/$(database)/documents/households/$(householdId)/transactions/$(transactionId); }
    function accountPath(householdId, accountId) { return /databases/$(database)/documents/households/$(householdId)/accounts/$(accountId); }
    function approvedOwner() {
      return signedIn()
        && access(request.auth.uid).data.active == true
        && access(request.auth.uid).data.role == 'owner';
    }
    function hasPendingInvite() {
      return signedIn()
        && email() != null
        && inviteForCurrentEmail().data.email == email()
        && inviteForCurrentEmail().data.status == 'pending';
    }
    function isOwner(householdId) {
      return approvedOwner() && household(householdId).data.ownerId == request.auth.uid;
    }
    function isRestoreOwner(householdId) {
      return isOwner(householdId)
        && household(householdId).data.restoreStatus == 'importing'
        && nonEmpty(household(householdId).data.restoreOperationId, 200)
        && nonEmpty(household(householdId).data.restoreChecksum, 200);
    }
    function isMember(householdId) {
      return signedIn()
        && member(householdId, request.auth.uid).data.active == true
        && (member(householdId, request.auth.uid).data.role == 'member' || approvedOwner());
    }
    function validInviteAcceptance(householdId) {
      return signedIn()
        && email() != null
        && inviteForCurrentEmail().data.householdId == householdId
        && inviteForCurrentEmail().data.status == 'pending'
        && inviteAfterCurrentEmail().data.status == 'accepted'
        && inviteAfterCurrentEmail().data.acceptedBy == request.auth.uid;
    }
    function nonEmpty(value, cap) { return value is string && value.size() > 0 && value.size() <= cap; }
    function optionalString(value, cap) { return value == null || (value is string && value.size() <= cap); }
    function safePositiveMoney(value) { return value is int && value > 0 && value <= 9007199254740991; }
    function safeNonNegativeMoney(value) { return value is int && value >= 0 && value <= 9007199254740991; }
    function safeMoney(value) { return value is int && value >= -9007199254740991 && value <= 9007199254740991; }
    function validCalendarDate(value) {
      return value is string && value.matches(
        '^([0-9]{4}-((0[13578]|1[02])-(0[1-9]|[12][0-9]|3[01])|(0[469]|11)-(0[1-9]|[12][0-9]|30)|02-(0[1-9]|1[0-9]|2[0-8]))|([0-9]{2}(0[48]|[2468][048]|[13579][26])|([02468][048]|[13579][26])00)-02-29)$'
      );
    }
    function optionalCalendarDate(value) { return value == null || validCalendarDate(value); }
    function validAccountKeys(data) {
      let legacy = [
        'id', 'householdId', 'name', 'kind', 'openingBalanceMinor', 'includeInTotal', 'photoDataUrl', 'archivedAt'
      ];
      let complete = [
        'id', 'householdId', 'name', 'kind', 'subtype', 'openingBalanceMinor', 'includeInTotal',
        'photoDataUrl', 'archivedAt', 'creditLimitMinor', 'statementDay', 'dueDay', 'loanType',
        'originalPrincipalMinor', 'scheduledPaymentMinor', 'expectedPayoffDate'
      ];
      let malaysiaLoans = [
        'id', 'householdId', 'name', 'kind', 'subtype', 'openingBalanceMinor', 'includeInTotal',
        'photoDataUrl', 'archivedAt', 'creditLimitMinor', 'statementDay', 'dueDay', 'loanType',
        'loanCalculationMode', 'annualInterestRateBps', 'originalPrincipalMinor', 'scheduledPaymentMinor', 'expectedPayoffDate'
      ];
      return (data.keys().hasAll(legacy) && data.keys().hasOnly(legacy))
        || (data.keys().hasAll(complete) && data.keys().hasOnly(complete))
        || (data.keys().hasAll(malaysiaLoans) && data.keys().hasOnly(malaysiaLoans));
    }
    function completeAccount(data) { return data.keys().hasAny(['subtype']); }
    function validAccountSubtype(data) {
      return !completeAccount(data) || (
        data.subtype in ['asset', 'credit_card', 'loan', 'generic_liability']
        && ((data.kind == 'asset' && data.subtype == 'asset')
          || (data.kind == 'liability' && data.subtype in ['credit_card', 'loan', 'generic_liability']))
        && (data.subtype == 'credit_card'
          ? ((data.creditLimitMinor == null || safePositiveMoney(data.creditLimitMinor))
            && (data.statementDay == null || (data.statementDay is int && data.statementDay >= 1 && data.statementDay <= 31))
            && (data.dueDay == null || (data.dueDay is int && data.dueDay >= 1 && data.dueDay <= 31)))
          : (data.creditLimitMinor == null && data.statementDay == null && data.dueDay == null))
        && (data.subtype == 'loan'
          ? ((data.loanType == null || data.loanType in ['car', 'home', 'other'])
            && (!data.keys().hasAny(['loanCalculationMode']) || data.loanCalculationMode == null || data.loanCalculationMode in ['fixed_instalment', 'reducing_balance', 'manual'])
            && (!data.keys().hasAny(['annualInterestRateBps']) || data.annualInterestRateBps == null
              || (data.annualInterestRateBps is int && data.annualInterestRateBps > 0 && data.annualInterestRateBps <= 10000))
            && (!data.keys().hasAny(['annualInterestRateBps']) || data.annualInterestRateBps == null
              || (data.keys().hasAny(['loanCalculationMode']) && data.loanCalculationMode == 'reducing_balance'))
            && (data.originalPrincipalMinor == null || safePositiveMoney(data.originalPrincipalMinor))
            && (data.scheduledPaymentMinor == null || safePositiveMoney(data.scheduledPaymentMinor))
            && optionalCalendarDate(data.expectedPayoffDate))
          : (data.loanType == null
            && (!data.keys().hasAny(['loanCalculationMode']) || data.loanCalculationMode == null)
            && (!data.keys().hasAny(['annualInterestRateBps']) || data.annualInterestRateBps == null)
            && data.originalPrincipalMinor == null
            && data.scheduledPaymentMinor == null && data.expectedPayoffDate == null))
      );
    }
    function validAccountShape(data, householdId, accountId) {
      return validAccountKeys(data)
        && data.id == accountId && data.householdId == householdId
        && nonEmpty(data.name, 200)
        && data.kind in ['asset', 'liability']
        && safeMoney(data.openingBalanceMinor)
        && (data.kind != 'liability' || data.openingBalanceMinor >= 0)
        && data.includeInTotal is bool
        && (data.photoDataUrl == null || (data.photoDataUrl is string
          && data.photoDataUrl.matches('^data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+$')
          && data.photoDataUrl.size() <= 300000))
        && (data.archivedAt == null || nonEmpty(data.archivedAt, 100))
        && validAccountSubtype(data);
    }
    function validItemShape(data, householdId, itemId) {
      return data.keys().hasAll([
          'id', 'householdId', 'name', 'note', 'fullPriceMinor', 'paidMinor', 'status', 'coverMediaId',
          'createdByUid', 'createdAt', 'updatedByUid', 'updatedAt', 'archivedAt', 'revision',
          'lastOperationId', 'lastPaymentId'
        ])
        && data.keys().hasOnly([
          'id', 'householdId', 'name', 'note', 'fullPriceMinor', 'paidMinor', 'status', 'coverMediaId',
          'createdByUid', 'createdAt', 'updatedByUid', 'updatedAt', 'archivedAt', 'revision',
          'lastOperationId', 'lastPaymentId', 'etaDate', 'deletedAt', 'deletedByUid'
        ])
        && data.id == itemId
        && data.householdId == householdId
        && nonEmpty(data.name, 200)
        && optionalString(data.note, 2000)
        && safePositiveMoney(data.fullPriceMinor)
        && safeNonNegativeMoney(data.paidMinor)
        && data.paidMinor <= data.fullPriceMinor
        && data.status in ['active', 'completed', 'archived']
        && (data.coverMediaId == null || nonEmpty(data.coverMediaId, 200))
        && nonEmpty(data.createdByUid, 200)
        && nonEmpty(data.createdAt, 100)
        && nonEmpty(data.updatedByUid, 200)
        && nonEmpty(data.updatedAt, 100)
        && (data.archivedAt == null || nonEmpty(data.archivedAt, 100))
        && data.revision is int && data.revision >= 1
        && nonEmpty(data.lastOperationId, 200)
        && (data.lastPaymentId == null || nonEmpty(data.lastPaymentId, 200))
        && (!data.keys().hasAny(['etaDate']) || optionalCalendarDate(data.etaDate))
        && (!data.keys().hasAny(['deletedAt']) || data.deletedAt == null || nonEmpty(data.deletedAt, 100))
        && (!data.keys().hasAny(['deletedByUid']) || data.deletedByUid == null || nonEmpty(data.deletedByUid, 200))
        && ((!data.keys().hasAny(['deletedAt']) || data.deletedAt == null)
          == (!data.keys().hasAny(['deletedByUid']) || data.deletedByUid == null))
        && ((data.status == 'archived') == (data.archivedAt != null))
        && (data.status != 'completed' || data.paidMinor == data.fullPriceMinor)
        && (data.status != 'active' || data.paidMinor < data.fullPriceMinor);
    }
    function validMediaReferenceAfter(householdId, itemId, mediaId, kind, paymentId) {
      return mediaId == null || (
        existsAfter(mediaPath(householdId, mediaId))
        && getAfter(mediaPath(householdId, mediaId)).data.id == mediaId
        && getAfter(mediaPath(householdId, mediaId)).data.householdId == householdId
        && getAfter(mediaPath(householdId, mediaId)).data.itemId == itemId
        && getAfter(mediaPath(householdId, mediaId)).data.kind == kind
        && getAfter(mediaPath(householdId, mediaId)).data.paymentId == paymentId
      );
    }
    function validItemCreate(data, householdId, itemId) {
      return validItemShape(data, householdId, itemId)
        && data.createdByUid == request.auth.uid
        && data.updatedByUid == request.auth.uid
        && data.createdAt == data.updatedAt
        && data.archivedAt == null
        && itemNotDeleted(data)
        && (!data.keys().hasAny(['deletedByUid']) || data.deletedByUid == null)
        && data.revision == 1
        && validMediaReferenceAfter(householdId, itemId, data.coverMediaId, 'cover', null)
        && (
          (data.lastPaymentId == null && data.paidMinor == 0 && data.status == 'active')
          || (
            data.lastPaymentId != null
            && !exists(paymentPath(householdId, data.lastPaymentId))
            && existsAfter(paymentPath(householdId, data.lastPaymentId))
            && getAfter(paymentPath(householdId, data.lastPaymentId)).data.itemId == itemId
            && getAfter(paymentPath(householdId, data.lastPaymentId)).data.status == 'active'
            && getAfter(paymentPath(householdId, data.lastPaymentId)).data.amountMinor == data.paidMinor
          )
        );
    }
    function immutableItemFields(after, before) {
      return after.id == before.id
        && after.householdId == before.householdId
        && after.createdByUid == before.createdByUid
        && after.createdAt == before.createdAt;
    }
    function etaPreserved(after, before) {
      return before.keys().hasAny(['etaDate'])
        ? (after.keys().hasAny(['etaDate']) && after.etaDate == before.etaDate)
        : !after.keys().hasAny(['etaDate']);
    }
    function itemNotDeleted(data) {
      return !data.keys().hasAny(['deletedAt']) || data.deletedAt == null;
    }
    function deletedStatePreserved(after, before) {
      return before.keys().hasAny(['deletedAt'])
        ? (after.keys().hasAny(['deletedAt']) && after.deletedAt == before.deletedAt
          && after.keys().hasAny(['deletedByUid']) && after.deletedByUid == before.deletedByUid)
        : !after.keys().hasAny(['deletedAt', 'deletedByUid']);
    }
    function itemPaymentMutation(after, before, householdId) {
      let paymentId = after.lastPaymentId;
      return paymentId != null
        && after.diff(before).affectedKeys().hasOnly([
          'paidMinor', 'status', 'updatedByUid', 'updatedAt', 'revision', 'lastOperationId', 'lastPaymentId'
        ])
        && before.archivedAt == null && after.archivedAt == null
        && after.fullPriceMinor == before.fullPriceMinor
        && after.name == before.name && after.note == before.note && after.coverMediaId == before.coverMediaId
        && etaPreserved(after, before)
        && itemNotDeleted(before) && itemNotDeleted(after)
        && deletedStatePreserved(after, before)
        && existsAfter(paymentPath(householdId, paymentId))
        && getAfter(paymentPath(householdId, paymentId)).data.itemId == after.id
        && getAfter(paymentPath(householdId, paymentId)).data.lastOperationId == after.lastOperationId
        && getAfter(paymentPath(householdId, paymentId)).data.updatedAt == after.updatedAt
        && (
          (
            !exists(paymentPath(householdId, paymentId))
            && getAfter(paymentPath(householdId, paymentId)).data.status == 'active'
            && after.paidMinor == before.paidMinor + getAfter(paymentPath(householdId, paymentId)).data.amountMinor
          )
          || (
            exists(paymentPath(householdId, paymentId))
            && get(paymentPath(householdId, paymentId)).data.status == 'active'
            && getAfter(paymentPath(householdId, paymentId)).data.status == 'voided'
            && after.paidMinor == before.paidMinor - get(paymentPath(householdId, paymentId)).data.amountMinor
          )
          || (
            exists(paymentPath(householdId, paymentId))
            && get(paymentPath(householdId, paymentId)).data.status == 'voided'
            && getAfter(paymentPath(householdId, paymentId)).data.status == 'active'
            && after.paidMinor == before.paidMinor + get(paymentPath(householdId, paymentId)).data.amountMinor
          )
        )
        && after.status == (after.paidMinor == after.fullPriceMinor ? 'completed' : 'active');
    }
    function itemMetadataMutation(after, before, householdId) {
      return after.diff(before).affectedKeys().hasOnly([
          'name', 'note', 'fullPriceMinor', 'etaDate', 'status', 'coverMediaId', 'updatedByUid', 'updatedAt', 'revision', 'lastOperationId'
        ])
        && after.paidMinor == before.paidMinor
        && after.lastPaymentId == before.lastPaymentId
        && before.archivedAt == null && after.archivedAt == null
        && itemNotDeleted(before) && itemNotDeleted(after)
        && deletedStatePreserved(after, before)
        && after.status == (after.paidMinor == after.fullPriceMinor ? 'completed' : 'active')
        && validMediaReferenceAfter(householdId, after.id, after.coverMediaId, 'cover', null);
    }
    function itemArchiveMutation(after, before) {
      return after.diff(before).affectedKeys().hasOnly([
          'status', 'archivedAt', 'etaDate', 'updatedByUid', 'updatedAt', 'revision', 'lastOperationId'
        ])
        && after.name == before.name && after.note == before.note
        && after.fullPriceMinor == before.fullPriceMinor && after.paidMinor == before.paidMinor
        && after.coverMediaId == before.coverMediaId && after.lastPaymentId == before.lastPaymentId
        && etaPreserved(after, before)
        && itemNotDeleted(before) && itemNotDeleted(after)
        && deletedStatePreserved(after, before)
        && (
          (before.archivedAt == null && before.status == 'completed'
            && before.paidMinor == before.fullPriceMinor
            && after.status == 'archived' && after.archivedAt != null)
          || (before.status == 'archived' && before.archivedAt != null
            && after.archivedAt == null
            && after.status == (after.paidMinor == after.fullPriceMinor ? 'completed' : 'active'))
        );
    }
    function itemDeleteMutation(after, before) {
      return after.diff(before).affectedKeys().hasOnly([
          'status', 'deletedAt', 'deletedByUid', 'updatedByUid', 'updatedAt', 'revision', 'lastOperationId'
        ])
        && before.archivedAt == null && after.archivedAt == null
        && before.paidMinor == 0 && after.paidMinor == 0
        && after.status == 'active'
        && after.name == before.name && after.note == before.note
        && after.fullPriceMinor == before.fullPriceMinor
        && after.coverMediaId == before.coverMediaId && after.lastPaymentId == before.lastPaymentId
        && etaPreserved(after, before)
        && (
          (itemNotDeleted(before)
            && after.keys().hasAll(['deletedAt', 'deletedByUid'])
            && after.deletedAt == after.updatedAt && after.deletedByUid == request.auth.uid)
          || (!itemNotDeleted(before)
            && after.keys().hasAll(['deletedAt', 'deletedByUid'])
            && after.deletedAt == null && after.deletedByUid == null)
        );
    }
    function validItemUpdate(after, before, householdId, itemId) {
      return validItemShape(after, householdId, itemId)
        && immutableItemFields(after, before)
        && after.revision == before.revision + 1
        && after.updatedByUid == request.auth.uid
        && (itemPaymentMutation(after, before, householdId)
          || itemMetadataMutation(after, before, householdId)
          || itemArchiveMutation(after, before)
          || itemDeleteMutation(after, before));
    }
    function validPaymentShape(data, householdId, paymentId) {
      return data.keys().hasAll([
          'id', 'householdId', 'itemId', 'type', 'amountMinor', 'occurredAt', 'note', 'receiptMediaId',
          'ledgerMode', 'accountId', 'transactionId', 'status', 'actorUid', 'createdAt', 'updatedByUid', 'updatedAt',
          'voidedAt', 'lastOperationId'
        ])
        && data.keys().hasOnly([
          'id', 'householdId', 'itemId', 'type', 'amountMinor', 'occurredAt', 'note', 'receiptMediaId',
          'ledgerMode', 'accountId', 'transactionId', 'status', 'actorUid', 'createdAt', 'updatedByUid', 'updatedAt',
          'voidedAt', 'lastOperationId'
        ])
        && data.id == paymentId && data.householdId == householdId
        && nonEmpty(data.itemId, 200)
        && data.type in ['deposit', 'payment']
        && safePositiveMoney(data.amountMinor)
        && nonEmpty(data.occurredAt, 100)
        && optionalString(data.note, 2000)
        && (data.receiptMediaId == null || nonEmpty(data.receiptMediaId, 200))
        && data.ledgerMode in ['linked', 'independent']
        && (data.ledgerMode == 'linked'
          ? (nonEmpty(data.accountId, 200) && data.transactionId == 'item-payment-' + paymentId)
          : (data.accountId == null && data.transactionId == null))
        && data.status in ['active', 'voided']
        && nonEmpty(data.actorUid, 200)
        && nonEmpty(data.createdAt, 100)
        && nonEmpty(data.updatedByUid, 200)
        && nonEmpty(data.updatedAt, 100)
        && (data.voidedAt == null || nonEmpty(data.voidedAt, 100))
        && ((data.status == 'voided') == (data.voidedAt != null))
        && nonEmpty(data.lastOperationId, 200);
    }
    function linkedTransactionMatchesPayment(householdId, payment) {
      return existsAfter(transactionPath(householdId, payment.transactionId))
        && getAfter(transactionPath(householdId, payment.transactionId)).data.id == payment.transactionId
        && getAfter(transactionPath(householdId, payment.transactionId)).data.householdId == householdId
        && getAfter(transactionPath(householdId, payment.transactionId)).data.sourceType == 'itemPayment'
        && getAfter(transactionPath(householdId, payment.transactionId)).data.sourceItemId == payment.itemId
        && getAfter(transactionPath(householdId, payment.transactionId)).data.sourcePaymentId == payment.id
        && getAfter(transactionPath(householdId, payment.transactionId)).data.accountId == payment.accountId
        && getAfter(transactionPath(householdId, payment.transactionId)).data.amountMinor == payment.amountMinor
        && getAfter(transactionPath(householdId, payment.transactionId)).data.actorUid == payment.actorUid
        && getAfter(transactionPath(householdId, payment.transactionId)).data.lastOperationId == payment.lastOperationId
        && getAfter(transactionPath(householdId, payment.transactionId)).data.deletedAt == payment.voidedAt;
    }
    function validPaymentCreate(data, householdId, paymentId) {
      return validPaymentShape(data, householdId, paymentId)
        && data.status == 'active' && data.voidedAt == null
        && data.actorUid == request.auth.uid && data.updatedByUid == request.auth.uid
        && data.createdAt == data.updatedAt
        && existsAfter(itemPath(householdId, data.itemId))
        && itemNotDeleted(getAfter(itemPath(householdId, data.itemId)).data)
        && getAfter(itemPath(householdId, data.itemId)).data.lastPaymentId == paymentId
        && (
          (!exists(itemPath(householdId, data.itemId))
            && getAfter(itemPath(householdId, data.itemId)).data.createdAt == data.createdAt
            && getAfter(itemPath(householdId, data.itemId)).data.updatedAt == data.createdAt)
          || (exists(itemPath(householdId, data.itemId))
            && getAfter(itemPath(householdId, data.itemId)).data.lastOperationId == data.lastOperationId
            && getAfter(itemPath(householdId, data.itemId)).data.updatedAt == data.updatedAt)
        )
        && validMediaReferenceAfter(householdId, data.itemId, data.receiptMediaId, 'receipt', paymentId)
        && (data.ledgerMode == 'independent' || linkedTransactionMatchesPayment(householdId, data));
    }
    function validPaymentUpdate(after, before, householdId, paymentId) {
      return validPaymentShape(after, householdId, paymentId)
        && after.diff(before).affectedKeys().hasOnly(['status', 'updatedByUid', 'updatedAt', 'voidedAt', 'lastOperationId'])
        && after.id == before.id && after.householdId == before.householdId && after.itemId == before.itemId
        && after.type == before.type && after.amountMinor == before.amountMinor
        && after.occurredAt == before.occurredAt && after.note == before.note
        && after.receiptMediaId == before.receiptMediaId && after.ledgerMode == before.ledgerMode
        && after.accountId == before.accountId && after.transactionId == before.transactionId
        && after.actorUid == before.actorUid
        && after.createdAt == before.createdAt
        && after.updatedByUid == request.auth.uid
        && ((before.status == 'active' && after.status == 'voided' && after.voidedAt == after.updatedAt)
          || (before.status == 'voided' && after.status == 'active' && after.voidedAt == null))
        && existsAfter(itemPath(householdId, after.itemId))
        && itemNotDeleted(getAfter(itemPath(householdId, after.itemId)).data)
        && getAfter(itemPath(householdId, after.itemId)).data.lastPaymentId == paymentId
        && getAfter(itemPath(householdId, after.itemId)).data.lastOperationId == after.lastOperationId
        && getAfter(itemPath(householdId, after.itemId)).data.updatedAt == after.updatedAt
        && (after.ledgerMode == 'independent' || linkedTransactionMatchesPayment(householdId, after));
    }
    function validMediaShape(data, householdId, mediaId) {
      return data.keys().hasAll([
          'id', 'householdId', 'itemId', 'paymentId', 'kind', 'dataUrl', 'dataUrlLength',
          'width', 'height', 'createdByUid', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'householdId', 'itemId', 'paymentId', 'kind', 'dataUrl', 'dataUrlLength',
          'width', 'height', 'createdByUid', 'createdAt', 'updatedAt'
        ])
        && data.id == mediaId && data.householdId == householdId
        && nonEmpty(data.itemId, 200)
        && data.kind in ['cover', 'receipt']
        && data.dataUrl is string
        && data.dataUrl.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')
        && data.dataUrlLength is int && data.dataUrlLength == data.dataUrl.size()
        && data.width is int && data.width > 0
        && data.height is int && data.height > 0
        && data.createdByUid == request.auth.uid
        && nonEmpty(data.createdAt, 100) && data.updatedAt == data.createdAt
        && (data.kind == 'cover'
          ? (data.paymentId == null && data.dataUrlLength <= 80000 && data.width <= 512 && data.height <= 512
            && existsAfter(itemPath(householdId, data.itemId))
            && getAfter(itemPath(householdId, data.itemId)).data.coverMediaId == mediaId)
          : (nonEmpty(data.paymentId, 200) && data.dataUrlLength <= 180000 && data.width <= 1280 && data.height <= 1280
            && existsAfter(paymentPath(householdId, data.paymentId))
            && getAfter(paymentPath(householdId, data.paymentId)).data.itemId == data.itemId
            && getAfter(paymentPath(householdId, data.paymentId)).data.receiptMediaId == mediaId));
    }
    function transactionKeysValid(data) {
      let core = [
        'id', 'householdId', 'operationId', 'actorUid', 'kind', 'accountId', 'targetAccountId',
        'amountMinor', 'category', 'note', 'occurredAt', 'createdAt', 'deletedAt', 'purgedAt', 'lastOperationId'
      ];
      let allowed = [
        'id', 'householdId', 'operationId', 'actorUid', 'kind', 'accountId', 'targetAccountId',
        'amountMinor', 'principalMinor', 'interestMinor', 'category', 'note', 'occurredAt', 'createdAt',
        'deletedAt', 'purgedAt', 'lastOperationId', 'sourceType', 'sourceItemId', 'sourcePaymentId'
      ];
      return data.keys().hasAll(core) && data.keys().hasOnly(allowed)
        && (data.keys().hasAll(['principalMinor', 'interestMinor'])
          || !data.keys().hasAny(['principalMinor', 'interestMinor']))
        && (data.keys().hasAll(['sourceType', 'sourceItemId', 'sourcePaymentId'])
          || !data.keys().hasAny(['sourceType', 'sourceItemId', 'sourcePaymentId']));
    }
    function storedAccountSubtype(householdId, accountId) {
      let data = get(accountPath(householdId, accountId)).data;
      return data.keys().hasAny(['subtype'])
        ? data.subtype
        : (data.kind == 'asset' ? 'asset' : 'generic_liability');
    }
    function ordinaryPartsNull(data) {
      return !data.keys().hasAny(['principalMinor', 'interestMinor'])
        || (data.principalMinor == null && data.interestMinor == null);
    }
    function validTransactionAccounts(data, householdId) {
      return data.kind == 'repayment'
        ? (nonEmpty(data.targetAccountId, 200)
          && exists(accountPath(householdId, data.targetAccountId))
          && get(accountPath(householdId, data.targetAccountId)).data.kind == 'liability'
          && (data.accountId == null || (nonEmpty(data.accountId, 200)
            && exists(accountPath(householdId, data.accountId))
            && get(accountPath(householdId, data.accountId)).data.kind == 'asset')))
        : (nonEmpty(data.accountId, 200)
          && exists(accountPath(householdId, data.accountId))
          && (data.kind == 'income'
            ? (data.targetAccountId == null && get(accountPath(householdId, data.accountId)).data.kind == 'asset')
            : data.kind == 'expense'
              ? (data.targetAccountId == null
                && (get(accountPath(householdId, data.accountId)).data.kind == 'asset'
                  || (get(accountPath(householdId, data.accountId)).data.kind == 'liability'
                    && storedAccountSubtype(householdId, data.accountId) != 'loan')))
              : (nonEmpty(data.targetAccountId, 200)
                && data.targetAccountId != data.accountId
                && exists(accountPath(householdId, data.targetAccountId))
                && get(accountPath(householdId, data.accountId)).data.kind == 'asset'
                && get(accountPath(householdId, data.targetAccountId)).data.kind == 'asset')));
    }
    function validTransactionKind(data, householdId) {
      return data.kind == 'repayment'
        ? (data.keys().hasAll(['principalMinor', 'interestMinor'])
          && !data.keys().hasAny(['sourceType', 'sourceItemId', 'sourcePaymentId'])
          && safePositiveMoney(data.principalMinor)
          && safeNonNegativeMoney(data.interestMinor)
          && data.amountMinor == data.principalMinor + data.interestMinor
          && (storedAccountSubtype(householdId, data.targetAccountId) == 'loan'
            || (data.principalMinor == data.amountMinor && data.interestMinor == 0)))
        : ordinaryPartsNull(data);
    }
    function validTransactionShape(data, householdId, transactionId) {
      return transactionKeysValid(data)
        && data.id == transactionId && data.householdId == householdId
        && nonEmpty(data.operationId, 200) && nonEmpty(data.actorUid, 200)
        && data.kind in ['income', 'expense', 'transfer', 'repayment']
        && safePositiveMoney(data.amountMinor)
        && optionalString(data.category, 200) && optionalString(data.note, 2000)
        && nonEmpty(data.occurredAt, 100) && nonEmpty(data.createdAt, 100)
        && (data.deletedAt == null || nonEmpty(data.deletedAt, 100))
        && (data.purgedAt == null || nonEmpty(data.purgedAt, 100))
        && nonEmpty(data.lastOperationId, 200)
        && validTransactionAccounts(data, householdId)
        && validTransactionKind(data, householdId);
    }
    function validRestoreItem(data, householdId, itemId) {
      return isRestoreOwner(householdId)
        && validItemShape(data, householdId, itemId)
        && data.coverMediaId == null
        && data.createdByUid == request.auth.uid
        && data.updatedByUid == request.auth.uid
        && (!data.keys().hasAny(['deletedByUid']) || data.deletedByUid == null || data.deletedByUid == request.auth.uid);
    }
    function validRestorePayment(data, householdId, paymentId) {
      return isRestoreOwner(householdId)
        && validPaymentShape(data, householdId, paymentId)
        && data.receiptMediaId == null
        && data.actorUid == request.auth.uid
        && data.updatedByUid == request.auth.uid
        && exists(itemPath(householdId, data.itemId));
    }
    function validRestoreTransaction(data, householdId, transactionId) {
      return isRestoreOwner(householdId)
        && validTransactionShape(data, householdId, transactionId)
        && data.actorUid == request.auth.uid
        && (!isLinkedTransaction(data) || (
          data.sourceType == 'itemPayment'
          && data.sourcePaymentId != null
          && exists(paymentPath(householdId, data.sourcePaymentId))
          && get(paymentPath(householdId, data.sourcePaymentId)).data.itemId == data.sourceItemId
          && get(paymentPath(householdId, data.sourcePaymentId)).data.transactionId == transactionId
        ));
    }
    function isLinkedTransaction(data) { return data.keys().hasAny(['sourceType', 'sourceItemId', 'sourcePaymentId']); }
    function repaymentIdentityPreserved(after, before) {
      return after.kind == 'repayment'
        && after.accountId == before.accountId && after.targetAccountId == before.targetAccountId
        && after.amountMinor == before.amountMinor && after.principalMinor == before.principalMinor
        && after.interestMinor == before.interestMinor;
    }
    function validLinkedTransaction(data, householdId, transactionId) {
      let paymentId = data.sourcePaymentId;
      return data.keys().hasAll(['sourceType', 'sourceItemId', 'sourcePaymentId'])
        && data.sourceType == 'itemPayment'
        && transactionId == 'item-payment-' + paymentId
        && data.kind == 'expense' && data.category == '购物'
        && data.targetAccountId == null && data.purgedAt == null
        && existsAfter(paymentPath(householdId, paymentId))
        && getAfter(paymentPath(householdId, paymentId)).data.ledgerMode == 'linked'
        && getAfter(paymentPath(householdId, paymentId)).data.transactionId == transactionId
        && getAfter(paymentPath(householdId, paymentId)).data.itemId == data.sourceItemId
        && getAfter(paymentPath(householdId, paymentId)).data.accountId == data.accountId
        && getAfter(paymentPath(householdId, paymentId)).data.amountMinor == data.amountMinor
        && getAfter(paymentPath(householdId, paymentId)).data.note == data.note
        && getAfter(paymentPath(householdId, paymentId)).data.occurredAt == data.occurredAt
        && getAfter(paymentPath(householdId, paymentId)).data.createdAt == data.createdAt
        && getAfter(paymentPath(householdId, paymentId)).data.actorUid == data.actorUid
        && getAfter(paymentPath(householdId, paymentId)).data.lastOperationId == data.lastOperationId
        && getAfter(paymentPath(householdId, paymentId)).data.voidedAt == data.deletedAt;
    }

    match /access/{userId} {
      allow read: if signedIn() && userId == request.auth.uid;
      allow write: if false;
    }

    match /users/{userId} {
      allow read: if signedIn() && userId == request.auth.uid;
      allow create: if signedIn()
        && userId == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == email()
        && (approvedOwner() || hasPendingInvite());
      allow update: if signedIn()
        && userId == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email;
      allow delete: if false;
    }

    match /invites/{inviteEmail} {
      allow read: if signedIn() && (inviteEmail == email() || isOwner(resource.data.householdId));
      allow create: if signedIn()
        && inviteEmail == request.resource.data.email
        && request.resource.data.status == 'pending'
        && request.resource.data.ownerUid == request.auth.uid
        && householdAfter(request.resource.data.householdId).data.ownerId == request.auth.uid;
      allow update: if signedIn()
        && inviteEmail == email()
        && resource.data.email == email()
        && resource.data.status == 'pending'
        && request.resource.data.status == 'accepted'
        && request.resource.data.acceptedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedBy', 'acceptedAt']);
      allow delete: if signedIn() && isOwner(resource.data.householdId);
    }

    match /households/{householdId} {
      allow create: if approvedOwner() && request.resource.data.ownerId == request.auth.uid;
      allow read: if isOwner(householdId) || isMember(householdId);
      allow update, delete: if isOwner(householdId) && request.resource.data.ownerId == resource.data.ownerId;

      match /members/{memberId} {
        allow read: if isOwner(householdId) || isMember(householdId);
        allow create: if signedIn()
          && request.resource.data.uid == memberId
          && request.resource.data.email == email()
          && (
            (memberId == request.auth.uid
              && request.resource.data.role == 'owner'
              && approvedOwner()
              && householdAfter(householdId).data.ownerId == request.auth.uid)
            || (memberId == request.auth.uid
              && request.resource.data.role == 'member'
              && validInviteAcceptance(householdId))
          );
        allow update: if isOwner(householdId)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.email == resource.data.email
          && resource.data.role == 'member'
          && request.resource.data.role == resource.data.role
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active']);
        allow delete: if false;
      }

      match /accounts/{accountId} {
        allow read: if isMember(householdId);
        allow create: if (isMember(householdId) || isRestoreOwner(householdId))
          && validAccountShape(request.resource.data, householdId, accountId)
          && (!isRestoreOwner(householdId) || request.resource.data.photoDataUrl == null);
        allow update: if isMember(householdId)
          && validAccountShape(request.resource.data, householdId, accountId)
          && request.resource.data.id == resource.data.id
          && request.resource.data.householdId == resource.data.householdId;
        allow delete: if false;
      }

      match /items/{itemId} {
        allow read: if isMember(householdId);
        allow create: if (isMember(householdId) && validItemCreate(request.resource.data, householdId, itemId))
          || validRestoreItem(request.resource.data, householdId, itemId);
        allow update: if isMember(householdId) && validItemUpdate(request.resource.data, resource.data, householdId, itemId);
        allow delete: if false;
      }

      match /itemPayments/{paymentId} {
        allow read: if isMember(householdId);
        allow create: if (isMember(householdId) && validPaymentCreate(request.resource.data, householdId, paymentId))
          || validRestorePayment(request.resource.data, householdId, paymentId);
        allow update: if isMember(householdId) && validPaymentUpdate(request.resource.data, resource.data, householdId, paymentId);
        allow delete: if false;
      }

      match /itemMedia/{mediaId} {
        allow read: if isMember(householdId);
        allow create: if isMember(householdId) && validMediaShape(request.resource.data, householdId, mediaId);
        allow update: if false;
        allow delete: if isMember(householdId)
          && resource.data.kind == 'cover'
          && getAfter(itemPath(householdId, resource.data.itemId)).data.coverMediaId != mediaId;
      }

      match /transactions/{transactionId} {
        allow read: if isMember(householdId);
        allow create: if (isMember(householdId)
            && validTransactionShape(request.resource.data, householdId, transactionId)
            && request.resource.data.actorUid == request.auth.uid
            && (isLinkedTransaction(request.resource.data)
              ? validLinkedTransaction(request.resource.data, householdId, transactionId)
              : !request.resource.data.keys().hasAny(['sourceType', 'sourceItemId', 'sourcePaymentId'])))
          || validRestoreTransaction(request.resource.data, householdId, transactionId);
        allow update: if isMember(householdId)
          && validTransactionShape(request.resource.data, householdId, transactionId)
          && request.resource.data.id == resource.data.id
          && request.resource.data.householdId == resource.data.householdId
          && request.resource.data.actorUid == resource.data.actorUid
          && request.resource.data.operationId == resource.data.operationId
          && (isLinkedTransaction(resource.data)
            ? (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedAt', 'lastOperationId'])
              && validLinkedTransaction(request.resource.data, householdId, transactionId))
            : (!isLinkedTransaction(request.resource.data)
              && (resource.data.kind == 'repayment'
                ? repaymentIdentityPreserved(request.resource.data, resource.data)
                : request.resource.data.kind != 'repayment')));
        allow delete: if false;
      }
    }
  }
}
