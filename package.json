{
  "name": "family-wallet-v2-local-demo",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test app/ledger.test.mjs app/migration.test.mjs app/pwa.test.mjs",
    "test:rules": "node --test app/firestore.rules.test.mjs",
    "test:rules:emulator": "firebase emulators:exec --project demo-family-wallet-v2 --only auth,firestore \"npm run test:rules\"",
    "audit:public": "node scripts/audit-public.mjs",
    "build": "node scripts/build.mjs",
    "serve": "python3 -m http.server 4173 -d app"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "firebase": "^12.16.0",
    "firebase-tools": "^15.28.1"
  }
}
